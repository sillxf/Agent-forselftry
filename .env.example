LLM_MODEL=gpt-6.1-sol
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://xxx/v1
# RAG: repository-relative paths or absolute local paths
RAG_KNOWLEDGE_DIR=app/knowledge
RAG_STORAGE_DIR=app/storage
# Keep the baseline small; set BAAI/bge-m3 explicitly for multilingual evaluation.
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_PARENT_MAX_TOKENS=1600
RAG_CHILD_MAX_TOKENS=400
RAG_CHILD_OVERLAP_TOKENS=60
RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_OCR_ENABLED=true
