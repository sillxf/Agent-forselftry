# Independent RAG service. Copy to .env; never commit tokens or provider secrets.
# Default data location is ./storage. Use an absolute path for deployed processes.
RAG_SERVICE_DATA=./storage
RAG_ALLOWED_HOSTS=localhost,127.0.0.1,::1
RAG_ALLOWED_ORIGINS=
# Optional alternative to the generated storage/admin.token (at least 24 characters).
# RAG_SERVICE_ADMIN_TOKEN=
RAG_MAX_LOADED_MODELS=3
RAG_SEARCH_CONCURRENCY=4
RAG_UPLOAD_MAX_BYTES=26214400
RAG_MODEL_ACQUIRE_TIMEOUT_SECONDS=5
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Multi-View is disabled by default; enabling offline generation may incur charges.
RAG_VIEW_MAX_REQUESTS_PER_BUILD=8
# RAG_VIEW_LLM_MODEL=
# RAG_VIEW_LLM_API_KEY=
# RAG_VIEW_LLM_BASE_URL=
# Compatible HTTP embedding credentials are referenced by model secret_env, never stored in model JSON.
# EMBEDDING_API_KEY=
RAG_REMOTE_MAX_REQUESTS_PER_OPERATION=128
RAG_REMOTE_MAX_INPUT_CHARS_PER_OPERATION=2000000
# Optional REST client / MCP stdio connection. Set a scoped read-only key for callers.
RAG_SERVICE_URL=http://127.0.0.1:8090
# RAG_SERVICE_TOKEN=
# RAG_SERVICE_KNOWLEDGE_BASES=
RAG_CLIENT_TIMEOUT=60
