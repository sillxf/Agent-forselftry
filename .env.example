LLM_MODEL=gpt-6.1-sol
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://xxx/v1
# RAG: repository-relative paths or absolute local paths
RAG_KNOWLEDGE_DIR=app/knowledge
RAG_STORAGE_DIR=app/storage
# Default multilingual embedding; MiniLM is retained only as a historical baseline.
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_PARENT_MAX_TOKENS=1600
RAG_CHILD_MAX_TOKENS=400
RAG_CHILD_OVERLAP_TOKENS=60
RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_OCR_ENABLED=true

# Optional online reranking; Hybrid remains the default.
RAG_RETRIEVAL_STRATEGY=hybrid
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_TIMEOUT_SECONDS=2
RAG_CONTEXT_CHAR_BUDGET=24000
# Bump when embedding weights/custom embedding behavior change under the same model name.
RAG_EMBEDDING_CACHE_REVISION=1
# Optional independent offline View generator (unset values inherit main LLM config).
# RAG_VIEW_LLM_MODEL=
# RAG_VIEW_LLM_BASE_URL=
# RAG_VIEW_LLM_API_KEY=

# Preferred: the security Agent is now an HTTP client of the independent RAG service.
# RAG_SERVICE_URL=http://127.0.0.1:8090
# RAG_SERVICE_TOKEN=<a read-only Agent key; do not use the admin token>
# RAG_SERVICE_KNOWLEDGE_BASES=<comma-separated knowledge base IDs>
# Explicit migration escape hatch only; never run legacy writers against the service data root.
RAG_EMBEDDED_MODE=false
