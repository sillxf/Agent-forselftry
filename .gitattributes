# Preserve document corpus bytes across platforms.
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.png binary

# Benchmark hashes must survive Windows checkout without newline conversion.
benchmark/datasets/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
*.zip binary

# Double-click launchers must also run after checkout with core.autocrlf=false.
*.cmd text eol=crlf
